# Shell configuration; use scripts/configure.sh to generate the actual .env.
export DATABASE_URL='jdbc:postgresql://YOUR-NEON-HOST:5432/YOUR-DATABASE?sslmode=verify-full'
export DATABASE_USERNAME='YOUR_ROLE'
export DATABASE_PASSWORD='YOUR_PASSWORD'
export NEXUS_DEMO=true
export DEMO_PASSWORD='CHOOSE_A_UNIQUE_LOCAL_DEMO_PASSWORD'
export EMAIL_ENABLED=false
export COOKIE_SECURE=false
# Optional restricted test delivery only:
# export RESEND_API_KEY=''
# export EMAIL_FROM='onboarding@resend.dev'
# export EMAIL_TEST_RECIPIENT=''
# Real deployment without demo uses ADMIN_PASSWORD once on a fresh database.
